# Docker Network & Database Configuration
POSTGRES_USER=budgetly_user
POSTGRES_PASSWORD=budgetly_secure_password_2026
POSTGRES_DB=budgetly_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@budgetly.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Service Ports
CLIENT_PORT=3000
SERVER_PORT=8000
AI_ENGINE_PORT=8001

# Core Backend JWT signing key (override with a long random value in production)
SECRET_KEY=super_secret_jwt_key_budgetly_2026_change_in_prod

# AI Engine address used by the Core Backend when running outside Docker Compose.
# Inside Compose this is injected as http://ai_engine:8001; leave it empty to
# always use the Core Backend's local NLP/OCR fallback.
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_TIMEOUT_SECONDS=2.5
